rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isActive', false)) == true; }
    function adminOrTeacher() { return active() && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher']); }

    match /profile_images/{uid}/{fileName} {
      allow read: if active();
      allow write: if active() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if active() && request.auth.uid == uid;
    }

    match /library/{fileName} {
      allow read: if active();
      allow write: if adminOrTeacher() && request.resource.size < 50 * 1024 * 1024 && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow delete: if adminOrTeacher();
    }
  }
}